rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidInviteId(id) {
      return id is string && id.size() <= 256 && id.matches('^[^/]+@[^/]+\\.[^/]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // An admin invitation is an admin vouching for an account: `invites/{email}`
    // can only be written by an admin (see the `invites` match below), so an
    // invite with role 'admin' grants the same rights as an `admins/{uid}`
    // document. Without this an account invited as "System Admin" reached the
    // admin portal (the client trusts the invite's role) while every admin write
    // was refused, which is one of the ways branch management failed.
    function hasAdminInvite() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/invites/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.role == 'admin';
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'justmenegi@gmail.com') ||
        hasAdminInvite()
      );
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myBranchId() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? myProfile().branchId
        : null;
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
             data.keys().hasOnly(['email', 'createdAt']) &&
             data.email is string && data.email.size() <= 256 &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'createdAt']) &&
             data.keys().hasOnly(['email', 'displayName', 'role', 'branchId', 'assignedBranches', 'createdAt']) &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['admin', 'branch'] &&
             // An unassigned profile stores no branchId, or a null one.
             (!('branchId' in data) || data.branchId == null || (data.branchId is string && data.branchId.size() <= 64)) &&
             (!('assignedBranches' in data) || (data.assignedBranches is list && data.assignedBranches.size() <= 20)) &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    // The manager contact is optional, so those keys may be missing *or* null.
    // Requiring a string whenever the key was present is what refused every
    // branch created from the admin portal: the form sent `managerEmail: null`
    // when the field was left empty, and the whole create was denied.
    function isValidBranch(data) {
      return data.keys().hasAll(['name', 'isActive']) &&
             data.keys().hasOnly(['name', 'isActive', 'managerEmail', 'managerName', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
             data.isActive is bool &&
             (!('managerEmail' in data) || data.managerEmail == null || (data.managerEmail is string && data.managerEmail.size() <= 256)) &&
             (!('managerName' in data) || data.managerName == null || (data.managerName is string && data.managerName.size() <= 100)) &&
             (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidStaffInvite(data) {
      return data.keys().hasAll(['email', 'displayName', 'branchId', 'branchName', 'role', 'status', 'createdAt']) &&
             data.keys().hasOnly(['email', 'displayName', 'branchId', 'branchName', 'role', 'invitedBy', 'status', 'createdAt']) &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.branchId is string && data.branchId.size() <= 64 &&
             data.branchName is string && data.branchName.size() <= 128 &&
             data.role in ['branch', 'admin'] &&
             data.status in ['invited', 'active'] &&
             (!('invitedBy' in data) || (data.invitedBy is string && data.invitedBy.size() <= 256)) &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidDailyReport(data) {
      return data.keys().hasAll(['branchId', 'branchName', 'reportDate', 'submittedBy', 'cashPaise', 'onlinePaise', 'lines', 'status', 'reviewStatus', 'createdAt']) &&
             data.keys().hasOnly(['branchId', 'branchName', 'reportDate', 'submittedBy', 'submittedByName', 'cashPaise', 'onlinePaise', 'lines', 'status', 'voidReason', 'note', 'reviewStatus', 'reviewNote', 'reviewedByName', 'reviewedAt', 'editedByName', 'editedAt', 'createdAt']) &&
             data.branchId is string && data.branchId.size() <= 64 &&
             data.branchName is string && data.branchName.size() <= 128 &&
             data.reportDate is string && data.reportDate.size() <= 10 &&
             data.submittedBy is string && data.submittedBy.size() <= 128 &&
             data.cashPaise is number && data.cashPaise >= 0 &&
             data.onlinePaise is number && data.onlinePaise >= 0 &&
             data.lines is list && data.lines.size() <= 100 &&
             data.status in ['active', 'voided'] &&
             data.reviewStatus in ['pending', 'ok', 'concern'] &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('voidReason' in data) || data.voidReason == null || (data.voidReason is string && data.voidReason.size() <= 500)) &&
             (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 1000)) &&
             (!('reviewNote' in data) || data.reviewNote == null || (data.reviewNote is string && data.reviewNote.size() <= 500)) &&
             (!('editedByName' in data) || data.editedByName == null || (data.editedByName is string && data.editedByName.size() <= 100)) &&
             (!('editedAt' in data) || data.editedAt == null || (data.editedAt is string && data.editedAt.size() <= 64));
    }

    // An advance is money received before the item is handed over. `appliedOn`
    // is the later sale date it was counted on; refunds are nested rows so the
    // ledger can show both without a second collection.
    function isValidAdvance(data) {
      return data.keys().hasAll(['branchId', 'customerName', 'itemName', 'amountPaise', 'advanceDate', 'refunds', 'createdAt']) &&
             data.keys().hasOnly(['branchId', 'customerName', 'itemName', 'amountPaise', 'advanceDate', 'appliedOn', 'appliedByName', 'refunds', 'note', 'createdAt']) &&
             data.branchId is string && data.branchId.size() <= 64 &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 200 &&
             data.itemName is string && data.itemName.size() > 0 && data.itemName.size() <= 200 &&
             data.amountPaise is number && data.amountPaise > 0 &&
             data.advanceDate is string && data.advanceDate.size() <= 10 &&
             data.refunds is list && data.refunds.size() <= 50 &&
             (!('appliedOn' in data) || data.appliedOn == null || (data.appliedOn is string && data.appliedOn.size() <= 10)) &&
             (!('appliedByName' in data) || data.appliedByName == null || (data.appliedByName is string && data.appliedByName.size() <= 100)) &&
             (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 500)) &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidDebt(data) {
      return data.keys().hasAll(['branchId', 'productName', 'amountPaise', 'debtDate', 'source', 'voided', 'payments', 'createdAt']) &&
             data.keys().hasOnly(['branchId', 'productName', 'amountPaise', 'debtDate', 'dueDate', 'source', 'voided', 'payments', 'createdAt']) &&
             data.branchId is string && data.branchId.size() <= 64 &&
             data.productName is string && data.productName.size() > 0 && data.productName.size() <= 200 &&
             data.amountPaise is number && data.amountPaise >= 0 &&
             data.debtDate is string && data.debtDate.size() <= 10 &&
             (!('dueDate' in data) || data.dueDate == null || (data.dueDate is string && data.dueDate.size() <= 10)) &&
             data.source in ['report', 'manual'] &&
             data.voided is bool &&
             data.payments is list && data.payments.size() <= 100 &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    // An offline sale is a reminder to enter an item in the separate daily-sales
    // system. Its amount is reference only: the money was already received as
    // cash or online, so no total is derived from this collection.
    function isValidOfflineSale(data) {
      return data.keys().hasAll(['branchId', 'itemName', 'amountPaise', 'saleDate', 'addedToSystem', 'createdAt']) &&
             data.keys().hasOnly(['branchId', 'itemName', 'amountPaise', 'saleDate', 'addedToSystem', 'addedAt', 'addedByName', 'createdAt']) &&
             data.branchId is string && data.branchId.size() <= 64 &&
             data.itemName is string && data.itemName.size() > 0 && data.itemName.size() <= 200 &&
             data.amountPaise is number && data.amountPaise >= 0 &&
             data.saleDate is string && data.saleDate.size() <= 10 &&
             data.addedToSystem is bool &&
             (!('addedAt' in data) || data.addedAt == null || (data.addedAt is string && data.addedAt.size() <= 64)) &&
             (!('addedByName' in data) || data.addedByName == null || (data.addedByName is string && data.addedByName.size() <= 100)) &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(adminId) && isValidAdmin(incoming());
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      // A profile cannot claim a role the account is not entitled to: 'admin'
      // only for an admin, 'branch' otherwise. Without this check anyone who
      // signed in could self-register `role: 'admin'` and be shown the admin
      // portal by the client.
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
                    isValidUserProfile(incoming()) &&
                    incoming().role == (isAdmin() ? 'admin' : 'branch');
      // A user may rename themselves, and may adopt the branch + role of the
      // invitation addressed to their own email — the invite is admin-written,
      // so its role is the authority, not the caller's claim.
      allow update: if isSignedIn() && isValidId(userId) && (
        isAdmin() ||
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName'])) ||
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['branchId', 'role']) &&
         request.auth.token.email != null &&
         exists(/databases/$(database)/documents/invites/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.branchId == incoming().branchId &&
         get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.role == incoming().role)
      );
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /invites/{inviteId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.email == request.auth.token.email);
      allow list: if isAdmin();
      allow create, delete: if isAdmin() && isValidInviteId(inviteId) && isValidStaffInvite(incoming());
      // An admin manages invitations. The invited person may only flip their own
      // invitation to 'active' on first sign-in — that is the one field, so the
      // portal's Invited/Active badge reflects reality without handing the
      // invitee the staff directory.
      allow update: if isValidInviteId(inviteId) && isValidStaffInvite(incoming()) && (
        isAdmin() ||
        (isSignedIn() &&
         resource.data.email == request.auth.token.email &&
         incoming().diff(resource.data).affectedKeys().hasOnly(['status']) &&
         incoming().status == 'active')
      );
    }

    // Branch names are readable by any signed-in staff member, deliberately not
    // scoped to the caller's own branch. Firestore rules are not filters: a
    // query has to be provably allowed for every document it could return, so
    // the previous `branchId == myBranchId() || resource.data.managerEmail == …`
    // condition denied the whole `collection('branches')` read for a branch
    // login. That denial left the client with no branch at all, which is what
    // stopped branch staff filing a daily report ("Could not file the report"),
    // and it silently broke the sign-in lookup that links an invited manager by
    // email. A branch document carries only a name, an active flag and the
    // manager contact, so reading it is not sensitive. Writes stay admin-only,
    // and reports/debts keep their own-branch scoping below.
    match /branches/{branchId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(branchId) && isValidBranch(incoming());
      allow delete: if isAdmin() && isValidId(branchId);
    }

    match /reports/{reportId} {
      allow get, list: if isSignedIn() && (isAdmin() || resource.data.branchId == myBranchId());
      allow create: if isSignedIn() && isValidId(reportId) &&
                    incoming().submittedBy == request.auth.uid &&
                    isValidDailyReport(incoming()) &&
                    (isAdmin() || incoming().branchId == myBranchId());
      allow update: if isSignedIn() && isValidId(reportId) && isValidDailyReport(incoming()) && (
        isAdmin() ||
        (existing().status == 'active' &&
         incoming().diff(existing()).affectedKeys().hasOnly(['reviewStatus', 'reviewNote', 'reviewedByName', 'reviewedAt']) &&
         isAdmin())
      );
      allow delete: if isAdmin() && isValidId(reportId);
    }

    match /debts/{debtId} {
      allow get, list: if isSignedIn() && (isAdmin() || resource.data.branchId == myBranchId());
      allow create: if isSignedIn() && isValidId(debtId) && isValidDebt(incoming()) &&
                    (isAdmin() || incoming().branchId == myBranchId());
      allow update: if isSignedIn() && isValidId(debtId) && isValidDebt(incoming()) && (
        isAdmin() ||
        (existing().branchId == myBranchId() &&
         incoming().diff(existing()).affectedKeys().hasOnly(['payments', 'dueDate']))
      );
      allow delete: if isAdmin() && isValidId(debtId);
    }

    match /advances/{advanceId} {
      allow get, list: if isSignedIn() && (isAdmin() || resource.data.branchId == myBranchId());
      allow create: if isSignedIn() && isValidId(advanceId) && isValidAdvance(incoming()) &&
                    (isAdmin() || incoming().branchId == myBranchId());
      // A held advance can be folded into a sale or refunded; its customer,
      // item, amount and received date stay untouched after it is recorded.
      allow update: if isSignedIn() && isValidId(advanceId) && isValidAdvance(incoming()) && (
        isAdmin() ||
        (existing().branchId == myBranchId() &&
         incoming().diff(existing()).affectedKeys().hasOnly(['appliedOn', 'appliedByName', 'refunds']))
      );
      allow delete: if isAdmin() && isValidId(advanceId);
    }

    match /offlineSales/{saleId} {
      allow get, list: if isSignedIn() && (isAdmin() || resource.data.branchId == myBranchId());
      allow create: if isSignedIn() && isValidId(saleId) && isValidOfflineSale(incoming()) &&
                    (isAdmin() || incoming().branchId == myBranchId());
      // The branch marks an item as entered in the other system (or undoes it);
      // the item, price and date stay untouched.
      allow update: if isSignedIn() && isValidId(saleId) && isValidOfflineSale(incoming()) && (
        isAdmin() ||
        (existing().branchId == myBranchId() &&
         incoming().diff(existing()).affectedKeys().hasOnly(['addedToSystem', 'addedAt', 'addedByName']))
      );
      allow delete: if isAdmin() && isValidId(saleId);
    }
  }
}
