rules_version = '2';

// SK Tapri Daily Sales — Firestore security rules.
//
// Paste this entire file into Firebase Console → Firestore Database → Rules,
// then press Publish. It is self-contained: do not keep any of the old text.
//
// What changed and why staff could not load their data:
//
//  1. The old read rules asked for `resource.data.branchId == myBranchId()`,
//     and `myBranchId()` read `.data.branchId` on the caller's profile. When
//     the profile was missing, still being written, or had no branchId, that
//     field access raised a rules *error*. Firestore reports a rule error to
//     the client as `permission-denied`, so the reports / debts / advances /
//     offline-sales listeners failed and the dashboard stayed blank. Every
//     lookup below uses `get()` (which returns null for a missing document)
//     and `Map.get(key, default)`, so an incomplete profile is an ordinary
//     "no" instead of a thrown error.
//
//  2. Branch membership came from the profile alone. The profile is linked at
//     the very end of sign-in and that write can itself be refused, so a
//     manager linked through the branch's `managerEmail`, or an invited
//     manager whose profile write had not landed yet, was refused every read
//     of their own branch. Branch access now accepts any of the three places
//     the app records that link: the profile, the invitation, the branch's
//     `managerEmail`.
//
//  3. Id patterns are written without any backslash escape (`'^[^/]+$'`,
//     `'^[^/]+@[^/]+$'`), so an email-shaped invite id like `manager@shop.com`
//     is accepted no matter how the rules engine handles escapes. The previous
//     pattern escaped its dot; if an escape is taken literally, every real
//     email address fails that check, which rejects every invitation and the
//     invitee's profile link-up.
//
//  4. A delete request has no `request.resource`, so shape checks on delete
//     denied every removal. Delete rules only check the caller and the id.
service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------------
    // Caller identity and lookups
    // ------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // Lower-cased because invitations are stored under the lower-cased email.
    function callerEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function adminPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function invitePath() {
      return /databases/$(database)/documents/invites/$(callerEmail());
    }

    function branchPath(branchId) {
      return /databases/$(database)/documents/branches/$(branchId);
    }

    // `get()` returns null when the document does not exist, which keeps a
    // missing profile or invitation from turning into a rule error.
    function userSnap() {
      return signedIn() ? get(userPath()) : null;
    }

    function inviteSnap() {
      return signedIn() && callerEmail() != '' ? get(invitePath()) : null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ------------------------------------------------------------------
    // Roles and branch membership
    // ------------------------------------------------------------------

    // An invitation is written by an admin only, so an invitation with
    // role 'admin' grants the same rights as an `admins/{uid}` document.
    function isAdmin() {
      let snap = inviteSnap();
      return signedIn() && (
        callerEmail() == 'justmenegi@gmail.com' ||
        get(adminPath()) != null ||
        (snap != null && snap.data.get('role', '') == 'admin')
      );
    }

    function profileBranchId() {
      return userSnap() != null ? userSnap().data.get('branchId', null) : null;
    }

    function inviteBranchId() {
      return inviteSnap() != null ? inviteSnap().data.get('branchId', null) : null;
    }

    // Deliberately permissive: a Firestore document id can never contain `/`,
    // so this rejects nothing the app writes while still guarding the paths
    // built below. A stricter pattern only risks locking a real account out of
    // its own profile over an id that is unusual but legal.
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 &&
             id.matches('^[^/]+$');
    }

    // Invitations are stored under the invitee's email address.
    function isValidInviteId(id) {
      return id is string && id.size() > 0 && id.size() <= 256 &&
             id.matches('^[^/]+@[^/]+$');
    }

    function branchSnap(branchId) {
      return isValidId(branchId) ? get(branchPath(branchId)) : null;
    }

    function managerEmailOf(branchId) {
      let snap = branchSnap(branchId);
      return snap != null && snap.data.get('managerEmail', '') is string
        ? snap.data.get('managerEmail', '').lower()
        : '';
    }

    function isBranchManager(branchId) {
      return callerEmail() != '' && managerEmailOf(branchId) == callerEmail();
    }

    // A caller may work with a branch when they are an admin, when their own
    // profile is linked to it, when an invitation places them in it, or when
    // the branch names them as its manager.
    function canUseBranch(branchId) {
      return isAdmin() || (
        branchId is string && branchId != '' && (
          branchId == profileBranchId() ||
          branchId == inviteBranchId() ||
          isBranchManager(branchId)
        )
      );
    }

    // ------------------------------------------------------------------
    // Document shapes
    // ------------------------------------------------------------------

    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
             data.keys().hasOnly(['email', 'createdAt']) &&
             data.email is string && data.email.size() <= 256 &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    // An unassigned profile stores no branchId, a null one, or an empty one.
    function isValidUserProfile(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'createdAt']) &&
             data.keys().hasOnly(['email', 'displayName', 'role', 'branchId', 'assignedBranches', 'createdAt']) &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['admin', 'branch'] &&
             (!('branchId' in data) || data.branchId == null || (data.branchId is string && data.branchId.size() <= 64)) &&
             (!('assignedBranches' in data) || (data.assignedBranches is list && data.assignedBranches.size() <= 20)) &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    // The manager contact is optional, so those keys may be missing *or* null.
    function isValidBranch(data) {
      return data.keys().hasAll(['name', 'isActive']) &&
             data.keys().hasOnly(['name', 'isActive', 'managerEmail', 'managerName', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
             data.isActive is bool &&
             (!('managerEmail' in data) || data.managerEmail == null || (data.managerEmail is string && data.managerEmail.size() <= 256)) &&
             (!('managerName' in data) || data.managerName == null || (data.managerName is string && data.managerName.size() <= 100)) &&
             (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidStaffInvite(data) {
      return data.keys().hasAll(['email', 'displayName', 'branchId', 'branchName', 'role', 'status', 'createdAt']) &&
             data.keys().hasOnly(['email', 'displayName', 'branchId', 'branchName', 'role', 'invitedBy', 'status', 'createdAt']) &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.branchId is string && data.branchId.size() <= 64 &&
             data.branchName is string && data.branchName.size() <= 128 &&
             data.role in ['branch', 'admin'] &&
             data.status in ['invited', 'active'] &&
             (!('invitedBy' in data) || (data.invitedBy is string && data.invitedBy.size() <= 256)) &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidDailyReport(data) {
      return data.keys().hasAll(['branchId', 'branchName', 'reportDate', 'submittedBy', 'cashPaise', 'onlinePaise', 'lines', 'status', 'reviewStatus', 'createdAt']) &&
             data.keys().hasOnly(['branchId', 'branchName', 'reportDate', 'submittedBy', 'submittedByName', 'cashPaise', 'onlinePaise', 'lines', 'status', 'shopClosed', 'voidReason', 'note', 'reviewStatus', 'reviewNote', 'reviewedByName', 'reviewedAt', 'editedByName', 'editedAt', 'createdAt']) &&
             data.branchId is string && data.branchId.size() <= 64 &&
             data.branchName is string && data.branchName.size() <= 128 &&
             data.reportDate is string && data.reportDate.size() <= 10 &&
             data.submittedBy is string && data.submittedBy.size() <= 128 &&
             data.cashPaise is number && data.cashPaise >= 0 &&
             data.onlinePaise is number && data.onlinePaise >= 0 &&
             data.lines is list && data.lines.size() <= 100 &&
             data.status in ['active', 'voided'] &&
             data.reviewStatus in ['pending', 'ok', 'concern'] &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             // Optional: a day the branch marked the shop closed. Older reports
             // never carried it, and they read as open.
             (!('shopClosed' in data) || data.shopClosed is bool) &&
             (!('voidReason' in data) || data.voidReason == null || (data.voidReason is string && data.voidReason.size() <= 500)) &&
             (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 1000)) &&
             (!('reviewNote' in data) || data.reviewNote == null || (data.reviewNote is string && data.reviewNote.size() <= 500)) &&
             (!('editedByName' in data) || data.editedByName == null || (data.editedByName is string && data.editedByName.size() <= 100)) &&
             (!('editedAt' in data) || data.editedAt == null || (data.editedAt is string && data.editedAt.size() <= 64));
    }

    // An advance is money received before the item is handed over.
    function isValidAdvance(data) {
      return data.keys().hasAll(['branchId', 'customerName', 'itemName', 'amountPaise', 'advanceDate', 'refunds', 'createdAt']) &&
             data.keys().hasOnly(['branchId', 'customerName', 'itemName', 'amountPaise', 'advanceDate', 'appliedOn', 'appliedByName', 'refunds', 'note', 'createdAt']) &&
             data.branchId is string && data.branchId.size() <= 64 &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 200 &&
             data.itemName is string && data.itemName.size() > 0 && data.itemName.size() <= 200 &&
             data.amountPaise is number && data.amountPaise > 0 &&
             data.advanceDate is string && data.advanceDate.size() <= 10 &&
             data.refunds is list && data.refunds.size() <= 50 &&
             (!('appliedOn' in data) || data.appliedOn == null || (data.appliedOn is string && data.appliedOn.size() <= 10)) &&
             (!('appliedByName' in data) || data.appliedByName == null || (data.appliedByName is string && data.appliedByName.size() <= 100)) &&
             (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 500)) &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidDebt(data) {
      return data.keys().hasAll(['branchId', 'productName', 'amountPaise', 'debtDate', 'source', 'voided', 'payments', 'createdAt']) &&
             data.keys().hasOnly(['branchId', 'productName', 'amountPaise', 'debtDate', 'dueDate', 'source', 'voided', 'payments', 'createdAt']) &&
             data.branchId is string && data.branchId.size() <= 64 &&
             data.productName is string && data.productName.size() > 0 && data.productName.size() <= 200 &&
             data.amountPaise is number && data.amountPaise >= 0 &&
             data.debtDate is string && data.debtDate.size() <= 10 &&
             (!('dueDate' in data) || data.dueDate == null || (data.dueDate is string && data.dueDate.size() <= 10)) &&
             data.source in ['report', 'manual'] &&
             data.voided is bool &&
             data.payments is list && data.payments.size() <= 100 &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    // An offline sale is a reminder; its amount is reference only.
    function isValidOfflineSale(data) {
      return data.keys().hasAll(['branchId', 'itemName', 'amountPaise', 'saleDate', 'addedToSystem', 'createdAt']) &&
             data.keys().hasOnly(['branchId', 'itemName', 'amountPaise', 'saleDate', 'addedToSystem', 'addedAt', 'addedByName', 'createdAt']) &&
             data.branchId is string && data.branchId.size() <= 64 &&
             data.itemName is string && data.itemName.size() > 0 && data.itemName.size() <= 200 &&
             data.amountPaise is number && data.amountPaise >= 0 &&
             data.saleDate is string && data.saleDate.size() <= 10 &&
             data.addedToSystem is bool &&
             (!('addedAt' in data) || data.addedAt == null || (data.addedAt is string && data.addedAt.size() <= 64)) &&
             (!('addedByName' in data) || data.addedByName == null || (data.addedByName is string && data.addedByName.size() <= 100)) &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    // ------------------------------------------------------------------
    // Collections
    // ------------------------------------------------------------------

    // Any signed-in account may check whether a uid is an admin (the client
    // checks its own); the list of admins is admin-only.
    match /admins/{adminId} {
      allow get: if signedIn() && isValidId(adminId);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(adminId) && isValidAdmin(incoming());
      allow delete: if isAdmin() && isValidId(adminId);
    }

    match /users/{userId} {
      allow get: if signedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      // 'branch' is the unprivileged role and may always be self-registered;
      // 'admin' needs an actual admin grant (admins doc, bootstrap email or an
      // admin invitation). This is also what lets an admin-invited account
      // create its profile at all: the old rule demanded the *client's* guess
      // of the role, so a refused create left the account with no profile.
      allow create: if signedIn() && isValidId(userId) && request.auth.uid == userId &&
                    isValidUserProfile(incoming()) &&
                    (incoming().get('role', '') == 'branch' || isAdmin());

      // A user may rename themselves, and may adopt the branch + role they are
      // entitled to — from an admin-written invitation, or from a branch that
      // names their email as its manager. Without the manager case the linking
      // write was refused, the profile stayed unassigned, and every
      // branch-scoped read for that manager was denied.
      allow update: if signedIn() && isValidId(userId) && (
        isAdmin() ||
        (request.auth.uid == userId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['displayName'])) ||
        (request.auth.uid == userId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['branchId', 'role']) &&
         incoming().get('role', '') is string &&
         (
           (incoming().get('role', '') == 'branch' &&
            isBranchManager(incoming().get('branchId', ''))) ||
           (inviteSnap() != null &&
            inviteSnap().data.get('branchId', null) == incoming().get('branchId', null) &&
            inviteSnap().data.get('role', null) == incoming().get('role', null))
         ))
      );

      allow delete: if isAdmin() && isValidId(userId);
    }

    // An admin manages invitations. The invitee may read their own (matched by
    // document id, so a *missing* invite returns "no document" instead of a
    // permission error) and may flip their own invite to 'active' on first
    // sign-in — that one field only.
    match /invites/{inviteId} {
      allow get: if signedIn() && isValidInviteId(inviteId) &&
                    (isAdmin() || (callerEmail() != '' && inviteId.lower() == callerEmail()));
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidInviteId(inviteId) && isValidStaffInvite(incoming());
      allow update: if signedIn() && isValidInviteId(inviteId) && isValidStaffInvite(incoming()) && (
        isAdmin() ||
        (callerEmail() != '' && inviteId.lower() == callerEmail() &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
         incoming().get('status', '') == 'active')
      );
      allow delete: if isAdmin() && isValidInviteId(inviteId);
    }

    // Branch names are readable by any signed-in staff member, deliberately not
    // scoped to the caller's own branch. Firestore rules are not filters: a
    // query has to be provably allowed for every document it could return, so
    // an own-branch-only rule denied the whole `collection('branches')` read,
    // which left the client with no branch and blocked filing a report. A
    // branch document holds only a name, an active flag and the manager
    // contact. Writes stay admin-only.
    match /branches/{branchId} {
      allow get, list: if signedIn();
      allow create, update: if isAdmin() && isValidId(branchId) && isValidBranch(incoming());
      allow delete: if isAdmin() && isValidId(branchId);
    }

    match /reports/{reportId} {
      allow get, list: if signedIn() && canUseBranch(existing().get('branchId', null));
      allow create: if signedIn() && isValidId(reportId) &&
                    incoming().get('submittedBy', '') == request.auth.uid &&
                    isValidDailyReport(incoming()) &&
                    canUseBranch(incoming().get('branchId', null));
      // Voiding, correcting and reviewing a filed report are admin actions.
      allow update: if signedIn() && isValidId(reportId) && isAdmin() &&
                    isValidDailyReport(incoming());
      allow delete: if isAdmin() && isValidId(reportId);
    }

    match /debts/{debtId} {
      allow get, list: if signedIn() && canUseBranch(existing().get('branchId', null));
      allow create: if signedIn() && isValidId(debtId) && isValidDebt(incoming()) &&
                    canUseBranch(incoming().get('branchId', null));
      // A branch may record a payment or set the due date; the product, amount
      // and date stay untouched once the debt is recorded.
      allow update: if signedIn() && isValidId(debtId) && isValidDebt(incoming()) && (
        isAdmin() ||
        (canUseBranch(existing().get('branchId', null)) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['payments', 'dueDate']))
      );
      allow delete: if isAdmin() && isValidId(debtId);
    }

    match /advances/{advanceId} {
      allow get, list: if signedIn() && canUseBranch(existing().get('branchId', null));
      allow create: if signedIn() && isValidId(advanceId) && isValidAdvance(incoming()) &&
                    canUseBranch(incoming().get('branchId', null));
      // A held advance can be folded into a sale or refunded; its customer,
      // item, amount and received date stay untouched.
      allow update: if signedIn() && isValidId(advanceId) && isValidAdvance(incoming()) && (
        isAdmin() ||
        (canUseBranch(existing().get('branchId', null)) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['appliedOn', 'appliedByName', 'refunds']))
      );
      allow delete: if isAdmin() && isValidId(advanceId);
    }

    match /offlineSales/{saleId} {
      allow get, list: if signedIn() && canUseBranch(existing().get('branchId', null));
      allow create: if signedIn() && isValidId(saleId) && isValidOfflineSale(incoming()) &&
                    canUseBranch(incoming().get('branchId', null));
      // The branch marks an item as entered in the other system (or undoes it).
      allow update: if signedIn() && isValidId(saleId) && isValidOfflineSale(incoming()) && (
        isAdmin() ||
        (canUseBranch(existing().get('branchId', null)) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['addedToSystem', 'addedAt', 'addedByName']))
      );
      allow delete: if isAdmin() && isValidId(saleId);
    }
  }
}
