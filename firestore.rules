rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidInviteId(id) {
      return id is string && id.size() <= 256 && id.matches('^[^/]+@[^/]+\\.[^/]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'justmenegi@gmail.com')
      );
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myBranchId() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? myProfile().branchId
        : null;
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
             data.keys().hasOnly(['email', 'createdAt']) &&
             data.email is string && data.email.size() <= 256 &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'createdAt']) &&
             data.keys().hasOnly(['email', 'displayName', 'role', 'branchId', 'assignedBranches', 'createdAt']) &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['admin', 'branch'] &&
             (!('branchId' in data) || (data.branchId is string && data.branchId.size() <= 64)) &&
             (!('assignedBranches' in data) || (data.assignedBranches is list && data.assignedBranches.size() <= 20)) &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidBranch(data) {
      return data.keys().hasAll(['name', 'isActive']) &&
             data.keys().hasOnly(['name', 'isActive', 'managerEmail', 'managerName', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
             data.isActive is bool &&
             (!('managerEmail' in data) || (data.managerEmail is string && data.managerEmail.size() <= 256)) &&
             (!('managerName' in data) || (data.managerName is string && data.managerName.size() <= 100)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidStaffInvite(data) {
      return data.keys().hasAll(['email', 'displayName', 'branchId', 'branchName', 'role', 'status', 'createdAt']) &&
             data.keys().hasOnly(['email', 'displayName', 'branchId', 'branchName', 'role', 'invitedBy', 'status', 'createdAt']) &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.branchId is string && data.branchId.size() <= 64 &&
             data.branchName is string && data.branchName.size() <= 128 &&
             data.role in ['branch', 'admin'] &&
             data.status in ['invited', 'active'] &&
             (!('invitedBy' in data) || (data.invitedBy is string && data.invitedBy.size() <= 256)) &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidDailyReport(data) {
      return data.keys().hasAll(['branchId', 'branchName', 'reportDate', 'submittedBy', 'cashPaise', 'onlinePaise', 'lines', 'status', 'reviewStatus', 'createdAt']) &&
             data.keys().hasOnly(['branchId', 'branchName', 'reportDate', 'submittedBy', 'submittedByName', 'cashPaise', 'onlinePaise', 'lines', 'status', 'voidReason', 'reviewStatus', 'reviewNote', 'reviewedByName', 'reviewedAt', 'createdAt']) &&
             data.branchId is string && data.branchId.size() <= 64 &&
             data.branchName is string && data.branchName.size() <= 128 &&
             data.reportDate is string && data.reportDate.size() <= 10 &&
             data.submittedBy is string && data.submittedBy.size() <= 128 &&
             data.cashPaise is number && data.cashPaise >= 0 &&
             data.onlinePaise is number && data.onlinePaise >= 0 &&
             data.lines is list && data.lines.size() <= 100 &&
             data.status in ['active', 'voided'] &&
             data.reviewStatus in ['pending', 'ok', 'concern'] &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('voidReason' in data) || data.voidReason == null || (data.voidReason is string && data.voidReason.size() <= 500)) &&
             (!('reviewNote' in data) || data.reviewNote == null || (data.reviewNote is string && data.reviewNote.size() <= 500));
    }

    function isValidDebt(data) {
      return data.keys().hasAll(['branchId', 'productName', 'amountPaise', 'debtDate', 'source', 'voided', 'payments', 'createdAt']) &&
             data.keys().hasOnly(['branchId', 'productName', 'amountPaise', 'debtDate', 'source', 'voided', 'payments', 'createdAt']) &&
             data.branchId is string && data.branchId.size() <= 64 &&
             data.productName is string && data.productName.size() > 0 && data.productName.size() <= 200 &&
             data.amountPaise is number && data.amountPaise >= 0 &&
             data.debtDate is string && data.debtDate.size() <= 10 &&
             data.source in ['report', 'manual'] &&
             data.voided is bool &&
             data.payments is list && data.payments.size() <= 100 &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(adminId) && isValidAdmin(incoming());
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserProfile(incoming());
      allow update: if isSignedIn() && isValidId(userId) && (
        isAdmin() ||
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName'])) ||
        (request.auth.uid == userId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['branchId', 'role']) &&
         incoming().role == 'branch' &&
         exists(/databases/$(database)/documents/invites/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.branchId == incoming().branchId &&
         get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.role == incoming().role)
      );
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /invites/{inviteId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.email == request.auth.token.email);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidInviteId(inviteId) && isValidStaffInvite(incoming());
    }

    // Branch names are readable by any signed-in staff member, deliberately not
    // scoped to the caller's own branch. Firestore rules are not filters: a
    // query has to be provably allowed for every document it could return, so
    // the previous `branchId == myBranchId() || resource.data.managerEmail == …`
    // condition denied the whole `collection('branches')` read for a branch
    // login. That denial left the client with no branch at all, which is what
    // stopped branch staff filing a daily report ("Could not file the report"),
    // and it silently broke the sign-in lookup that links an invited manager by
    // email. A branch document carries only a name, an active flag and the
    // manager contact, so reading it is not sensitive. Writes stay admin-only,
    // and reports/debts keep their own-branch scoping below.
    match /branches/{branchId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(branchId) && isValidBranch(incoming());
      allow delete: if isAdmin() && isValidId(branchId);
    }

    match /reports/{reportId} {
      allow get, list: if isSignedIn() && (isAdmin() || resource.data.branchId == myBranchId());
      allow create: if isSignedIn() && isValidId(reportId) &&
                    incoming().submittedBy == request.auth.uid &&
                    isValidDailyReport(incoming()) &&
                    (isAdmin() || incoming().branchId == myBranchId());
      allow update: if isSignedIn() && isValidId(reportId) && isValidDailyReport(incoming()) && (
        isAdmin() ||
        (existing().status == 'active' &&
         incoming().diff(existing()).affectedKeys().hasOnly(['reviewStatus', 'reviewNote', 'reviewedByName', 'reviewedAt']) &&
         isAdmin())
      );
      allow delete: if isAdmin() && isValidId(reportId);
    }

    match /debts/{debtId} {
      allow get, list: if isSignedIn() && (isAdmin() || resource.data.branchId == myBranchId());
      allow create: if isSignedIn() && isValidId(debtId) && isValidDebt(incoming()) &&
                    (isAdmin() || incoming().branchId == myBranchId());
      allow update: if isSignedIn() && isValidId(debtId) && isValidDebt(incoming()) && (
        isAdmin() ||
        (existing().branchId == myBranchId() &&
         incoming().diff(existing()).affectedKeys().hasOnly(['payments']))
      );
      allow delete: if isAdmin() && isValidId(debtId);
    }
  }
}
