# Supabase project URL (no secret on its own)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (client can read this; still kept in .env.local for dev only)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-side only, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# App timezone for IST date handling in server code (informational default).
APP_TIMEZONE=Asia/Kolkata

# Optional: app base URL used for password reset/email links in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
